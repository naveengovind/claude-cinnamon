{
  "manifest_version": 3,
  "name": "Cinnamon for Claude",
  "description": "Cinnamon's themes and extensions on claude.ai, from the cinnamon command on this Mac.",
  "version": "0.0.0",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "scripting", "storage", "userScripts"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://claude.ai/*"], "js": ["content.js"], "run_at": "document_start" }]
}
