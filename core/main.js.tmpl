// Cinnamon — runs in the Claude main process (evaluated by core/apply.sh through the app's own debugger).
// To every claude.ai view, now and on every reload, it applies: the core page code (extension runtime + Settings
// rows) and CSS, the enabled extensions' page code and CSS, and the selected theme. It starts the enabled bundled
// extensions' main parts, and watches config.json, themes and extensions so changes apply live.
// core/render.cjs fills in the double-underscore placeholders.
//
// Robustness: every app hook is optional and failures are caught, so a change in a future app version turns a
// feature off instead of breaking Claude. Event listeners are registered once per app run and always call through
// `state`, so a re-apply replaces the code they run. The page talks back through console messages prefixed
// "[cinnamon] " (no changes to the app's own IPC).
(async () => {
  // The debugger's `require` only exists until the first await: keep a reference for later (extension main parts).
  const load = require;
  const { app, webContents, shell, BrowserWindow } = load('electron');
  const fs = load('fs');
  const path = load('path');
  const ROOT = __ROOT__;
  const USER = __USER_DIR__;
  const themeDirs = __THEME_DIRS__ || [path.join(ROOT, 'themes'), path.join(USER, 'themes')];
  const extRoots = __EXT_ROOTS__ || { bundled: path.join(ROOT, 'extensions'), user: path.join(USER, 'extensions') };
  const configPath = path.join(USER, 'config.json');
  const userThemesDir = themeDirs[themeDirs.length - 1];
  const mod = (name) => { const p = path.join(ROOT, 'core', name); delete load.cache[p]; return load(p); };
  const themes = mod('theme.cjs');
  const exts = mod('extensions.cjs');
  const readCore = (name) => fs.readFileSync(path.join(ROOT, 'core', name), 'utf8');
  const coreJs = [readCore('page-runtime.js'), readCore('settings-ui.renderer.js')].join('\n;\n');
  const coreCss = readCore('settings-ui.css');
  const log = (...a) => console.warn('cinnamon:', ...a);

  // The global's name predates Cinnamon: listeners registered by earlier versions call through it.
  const state = (globalThis.__claudeMod ??= {});
  try { state.watcher?.close(); } catch {}                 // retire what versions before extensions left running
  clearInterval(state.timer); clearTimeout(state.debounce);
  state.watcher = null; state.timer = null;
  for (const w of state.themeWatchers || []) { try { w.close(); } catch {} }
  state.themeWatchers = null;
  state.keys ??= new Map();       // view id → core css key
  state.themeKeys ??= new Map();  // view id → theme css key
  state.themeApplied ??= new Map(); // view id → theme css text in place
  state.extKeys ??= new Map();    // view id → Map(ext id → [css keys])
  state.ran ??= new Map();        // view id → Map(ext id → code signature) of page code run since the last load
  state.dispatchHooked ??= new WeakSet();
  state.messageHooked ??= new WeakSet();
  state.mains ??= new Map();      // ext id → { instance, ctx }
  state.frameKeys ??= new Map();  // frame view id → css key clearing its background (glass themes)

  state.lastReload ??= new Map();
  function reloadView(wc) {
    const now = Date.now();
    if (now - (state.lastReload.get(wc.id) || 0) < 10_000) { log('skipped a reload (one per 10s)'); return; }
    state.lastReload.set(wc.id, now);
    wc.reload();
  }
  const isTarget = (wc) => !wc.isDestroyed() && /^https:\/\/claude\.ai\//.test(wc.getURL());
  // The app's own window page (behind the claude.ai view): it paints a solid backdrop behind the chat area.
  const isFrame = (wc) => !wc.isDestroyed() && /^file:\/\/.*main_window/.test(wc.getURL());
  const FRAME_CLEAR = 'html, body, body::before, body::after { background: transparent !important; background-color: transparent !important; }';
  const views = () => webContents.getAllWebContents().filter(isTarget);
  const config = () => themes.readConfig(configPath);

  // ---------------------------------------------------------------- themes
  function loadTheme() {
    try { state.theme = themes.resolveTheme(themeDirs, configPath); }
    catch (e) { state.theme = { current: 'default', css: '', window: null, errors: [String(e)], themes: [] }; }
    for (const e of state.theme.errors || []) log('theme:', e);
  }

  // Insert the new theme css before removing the old one, so the page never flashes the app's own colours.
  async function applyThemeTo(wc) {
    const css = state.theme?.css || '';
    if (state.themeApplied.get(wc.id) === css) return;
    const old = state.themeKeys.get(wc.id);
    state.themeKeys.delete(wc.id);
    if (css.trim()) {
      const key = await wc.insertCSS(css).catch(() => null);
      if (key) state.themeKeys.set(wc.id, key);
    }
    if (old) await wc.removeInsertedCSS(old).catch(() => {});
    state.themeApplied.set(wc.id, css);
  }

  // Window material (glass themes). The app picks its own material and may change it; while a theme's material is
  // on, the app's calls are held back and remembered, and that material is restored when the theme goes.
  function wrapWindow(win) {
    if (!win || win.isDestroyed?.() || win.__cinnamonWrapped) return;
    const proto = Object.getPrototypeOf(win);
    if (typeof proto.setVibrancy !== 'function') return;
    win.__cinnamonWrapped = true;
    win.setVibrancy = function (material, ...rest) {
      state.appMaterials ??= new WeakMap();
      state.appMaterials.set(win, material);
      const forced = state.windowMaterial;
      return proto.setVibrancy.call(win, forced ?? material, ...rest);
    };
  }
  // While a theme's window material is on, the frame page's backdrop is cleared so the glass shows through.
  async function applyFrame(wc) {
    const want = !!state.windowMaterial;
    const have = state.frameKeys.get(wc.id);
    if (want && !have) { const k = await wc.insertCSS(FRAME_CLEAR).catch(() => null); if (k) state.frameKeys.set(wc.id, k); }
    else if (!want && have) { state.frameKeys.delete(wc.id); await wc.removeInsertedCSS(have).catch(() => {}); }
  }
  const frames = () => webContents.getAllWebContents().filter(isFrame);

  async function applyWindowMaterial() {
    const want = state.theme?.window?.vibrancy ?? null;
    if (want === (state.windowMaterial ?? null)) { for (const f of frames()) await applyFrame(f); return; }
    const prev = state.windowMaterial ?? null;
    state.windowMaterial = want;
    let appAsked = null;
    if (!want) { // restore the app's own: what it last asked for, else what its page says it uses
      for (const wc of views()) {
        appAsked = await wc.executeJavaScript('document.documentElement.dataset.sidebarVibrancy || null').catch(() => null);
        if (appAsked) break;
      }
    }
    for (const win of BrowserWindow?.getAllWindows?.() || []) {
      try {
        wrapWindow(win);
        const proto = Object.getPrototypeOf(win);
        if (want) proto.setVibrancy.call(win, want);
        else if (prev) proto.setVibrancy.call(win, state.appMaterials?.get(win) ?? appAsked ?? null);
      } catch (e) { log('window material:', e); }
    }
    for (const f of frames()) await applyFrame(f);
  }

  async function setTheme(id) {
    const known = id === 'default' || (state.theme?.themes || []).some((t) => t.id === id && !t.error);
    if (!known) return;
    try { themes.writeConfig(configPath, { theme: id }); } catch (e) { log('could not save the theme:', e); return; }
    await state.reloadAll?.();
  }

  // ---------------------------------------------------------------- extensions
  const signature = (l) => `${l.page.join('\n/*--*/\n').length}:${hash(l.page.join('\n'))}`;
  function hash(s) { let h = 0; for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0; return h; }

  function loadExtensions() {
    const cfg = config();
    const list = exts.listExtensions(extRoots);
    state.extList = list.map((e) => ({ id: e.id, name: e.name, description: e.description, bundled: e.bundled, enabled: exts.isEnabled(e, cfg), ...(e.error ? { error: e.error } : {}) }));
    state.extLoaded = new Map();
    for (const e of list) {
      if (e.error) { log(`extension ${e.id}:`, e.error); continue; }
      if (!exts.isEnabled(e, cfg)) continue;
      const l = exts.loadExtension(e);
      for (const err of l.errors) log(err);
      state.extLoaded.set(e.id, { ...l, sig: signature(l), cssSig: hash(l.css.join('\n/*--*/\n')) });
    }
    state.settings = cfg.settings && typeof cfg.settings === 'object' && !Array.isArray(cfg.settings) ? cfg.settings : {};
  }

  const wrap = (id, code) => `(() => { const cinnamon = window.__cinnamon.api(${JSON.stringify(id)}); window.__cinnamon.reset(${JSON.stringify(id)});
try {
${code}
} catch (e) { console.warn('cinnamon: extension ' + ${JSON.stringify(id)} + ' failed', e); } })();`;

  async function pushPageState(wc) {
    const data = JSON.stringify({ current: state.theme.current, themes: state.theme.themes });
    const js = `(() => { window.__cinnamon?.setSettings(${JSON.stringify(state.settings)}); window.__cmSetThemes?.(${data}); window.__cmSetExtensions?.(${JSON.stringify(state.extList)}); return true; })()`;
    await wc.executeJavaScript(js).catch(() => {});
  }

  // Runs page code of enabled extensions not yet run in this view; returns true if the view needs a reload
  // (an extension was turned off, or its code changed: page code can't be un-run).
  async function applyExtensionsTo(wc) {
    const ran = state.ran.get(wc.id) || new Map();
    state.ran.set(wc.id, ran);
    for (const [id, sig] of ran) {
      const l = state.extLoaded.get(id);
      if (!l || l.sig !== sig) return true;
    }
    const had = state.extKeys.get(wc.id) || new Map();
    const next = new Map();
    for (const [id, l] of state.extLoaded) {
      const keys = [];
      for (const css of l.css) { const k = await wc.insertCSS(css).catch(() => null); if (k) keys.push(k); }
      next.set(id, keys);
      if (!ran.has(id) && l.page.length) { // css-only extensions are never recorded, so turning them off needs no reload
        for (const code of l.page) await wc.executeJavaScript(wrap(id, code)).catch(() => {});
        ran.set(id, l.sig);
      }
    }
    state.extKeys.set(wc.id, next);
    for (const keys of had.values()) for (const k of keys) await wc.removeInsertedCSS(k).catch(() => {});
    return false;
  }

  function makeCtx(id) {
    const timers = new Set();
    const watchers = [];
    const ready = [];
    const guard = (fn) => (...a) => { try { return Promise.resolve(fn(...a)).catch((e) => log(id, e)); } catch (e) { log(id, e); } };
    const ctx = {
      id,
      dataDir: path.join(USER, 'data', id),
      appDataDir: app.getPath('userData'),
      views,
      run: (wc, js) => wc.executeJavaScript(js).catch(() => undefined),
      onViewReady: (fn) => { ready.push(guard(fn)); },
      setInterval: (fn, ms) => { const t = setInterval(guard(fn), ms); timers.add(t); return t; },
      setTimeout: (fn, ms) => { const t = setTimeout(guard(fn), ms); timers.add(t); return t; },
      clearTimer: (t) => { clearInterval(t); clearTimeout(t); timers.delete(t); },
      watch: (p, opts, fn) => { try { const w = fs.watch(p, opts, guard(fn)); w.on('error', () => {}); watchers.push(w); return w; } catch { return null; } },
      log: (...a) => log(id, ...a),
      _ready: ready,
      _cleanup: () => { for (const t of timers) { clearInterval(t); clearTimeout(t); } timers.clear(); for (const w of watchers) { try { w.close(); } catch {} } },
    };
    try { fs.mkdirSync(ctx.dataDir, { recursive: true }); } catch {}
    return ctx;
  }
  function stopMains() {
    for (const [id, m] of state.mains) {
      try { m.instance?.deactivate?.(); } catch (e) { log(`extension ${id} stop:`, e); }
      try { m.ctx._cleanup(); } catch {}
    }
    state.mains.clear();
  }
  function startMains() {
    for (const [id, l] of state.extLoaded) {
      if (!l.main) continue;
      const ctx = makeCtx(id);
      try {
        delete load.cache[l.main];
        const instance = load(l.main).activate?.(ctx) || {};
        state.mains.set(id, { instance, ctx });
      } catch (e) { log(`extension ${id} failed to start:`, e); ctx._cleanup(); }
    }
  }
  async function viewReady(wc) {
    for (const { ctx } of state.mains.values()) for (const fn of ctx._ready) await fn(wc);
  }

  // ---------------------------------------------------------------- views
  async function applyTo(wc) {
    if (isFrame(wc)) { state.frameKeys.delete(wc.id); return applyFrame(wc); } // reached on the frame page's dom-ready
    if (!isTarget(wc)) return;
    // A fresh page: nothing of ours is in it any more. (Listeners from older versions don't reset this themselves.)
    state.ran.delete(wc.id);
    state.themeApplied.delete(wc.id);
    state.extKeys.delete(wc.id);
    const old = state.keys.get(wc.id);
    state.keys.delete(wc.id);
    if (coreCss.trim()) { const k = await wc.insertCSS(coreCss).catch(() => null); if (k) state.keys.set(wc.id, k); }
    if (old) await wc.removeInsertedCSS(old).catch(() => {});
    await wc.executeJavaScript(coreJs).catch(() => {});
    await pushPageState(wc); // settings before extension code runs
    if (await applyExtensionsTo(wc)) { reloadView(wc); return; }
    await applyThemeTo(wc);
    await pushPageState(wc);
    await viewReady(wc);
  }

  // After a config / theme / extension change: theme first, then extensions (reloading views that need it).
  async function reloadAll() {
    const before = [...(state.extLoaded || new Map())].map(([id, l]) => `${id}:${l.sig}:${l.cssSig}:${l.main || ''}`).join('|');
    loadTheme();
    loadExtensions();
    const after = [...state.extLoaded].map(([id, l]) => `${id}:${l.sig}:${l.cssSig}:${l.main || ''}`).join('|');
    const extChanged = before !== after;
    if (extChanged) { stopMains(); startMains(); }
    await applyWindowMaterial();
    for (const wc of views()) {
      await applyThemeTo(wc);
      if (extChanged && await applyExtensionsTo(wc)) { reloadView(wc); continue; }
      await pushPageState(wc);
      if (extChanged) await viewReady(wc);
    }
  }

  // ---------------------------------------------------------------- page messages
  const VALID_KEY = /^[A-Za-z0-9_.-]{1,64}$/;
  async function onPageMessage(wc, args) {
    // Only Claude's own top-level page may talk to Cinnamon: embedded frames (artifacts, previews) and messages whose
    // frame is unknown are ignored. (The older positional signature carries no frame at all.)
    const ev = args[0];
    if (typeof ev?.message === 'string') {
      const f = ev.frame;
      if (!f || (f !== wc.mainFrame && f.parent !== null)) return;
    }
    const raw = typeof ev?.message === 'string' ? ev.message : args[2];
    if (typeof raw !== 'string' || !raw.startsWith('[cinnamon] ')) return;
    let m;
    try { m = JSON.parse(raw.slice(11)); } catch { return; }
    if (!m || typeof m !== 'object') return;
    const known = (id) => (state.extList || []).some((e) => e.id === id && !e.error);
    switch (m.type) {
      case 'theme':
        if (typeof m.id === 'string') await state.setTheme?.(m.id);
        break;
      case 'open-themes-folder':
        try { fs.mkdirSync(userThemesDir, { recursive: true }); } catch {}
        await shell.openPath(userThemesDir).catch(() => {});
        break;
      case 'open-extensions-folder':
        try { fs.mkdirSync(extRoots.user, { recursive: true }); } catch {}
        await shell.openPath(extRoots.user).catch(() => {});
        break;
      case 'extension':
        if (!known(m.id) || typeof m.enabled !== 'boolean') return;
        themes.writeConfig(configPath, { extensions: { ...(config().extensions || {}), [m.id]: m.enabled } });
        await state.reloadAll?.();
        break;
      case 'ext-setting': {
        if (!known(m.ext) || typeof m.key !== 'string' || !VALID_KEY.test(m.key)) return;
        const value = JSON.stringify(m.value ?? null);
        if (value.length > 20000) return;
        const all = { ...(config().settings || {}) };
        all[m.ext] = { ...(all[m.ext] || {}), [m.key]: JSON.parse(value) };
        themes.writeConfig(configPath, { settings: all });
        state.settings = all;
        for (const v of views()) await v.executeJavaScript(`window.__cinnamon?.setSettings(${JSON.stringify(all)})`).catch(() => {});
        break;
      }
      case 'ext': {
        const main = state.mains.get(m.ext);
        if (main?.instance?.onMessage && typeof m.msg === 'string') {
          try { await main.instance.onMessage(m.msg, m.data, wc); } catch (e) { log(`extension ${m.ext} message:`, e); }
        }
        break;
      }
      default:
    }
  }

  function hook(wc) {
    const id = wc.id;
    if (!state.dispatchHooked.has(wc)) {
      state.dispatchHooked.add(wc);
      const forget = () => { state.frameKeys?.delete(id); state.keys.delete(id); state.themeKeys.delete(id); state.themeApplied?.delete(id); state.extKeys?.delete(id); state.ran?.delete(id); };
      wc.on('dom-ready', () => { forget(); Promise.resolve(state.applyTo?.(wc)).catch(() => {}); });
      wc.on('destroyed', forget);
    }
    // separate guard: views hooked by an older version still get the page-message listener
    if (!state.messageHooked.has(wc)) {
      state.messageHooked.add(wc);
      wc.on('console-message', (...args) => { Promise.resolve(state.onPageMessage?.(wc, args)).catch(() => {}); });
    }
  }

  // ---------------------------------------------------------------- start
  // Applies and reloads run one at a time (a theme pick, the config watcher and a page load can arrive together).
  state.queue ??= Promise.resolve();
  const serial = (fn) => { const run = state.queue.then(fn, fn); state.queue = run.catch((e) => log(e)); return run; };
  state.applyTo = (wc) => serial(() => applyTo(wc));
  state.hook = hook;
  state.reloadAll = () => serial(reloadAll);
  state.setTheme = setTheme;
  state.onPageMessage = onPageMessage;
  if (!state.dispatchListening) {
    state.dispatchListening = true;
    app.on('web-contents-created', (_e, wc) => state.hook?.(wc));
  }
  if (!state.windowListening) {
    state.windowListening = true;
    app.on('browser-window-created', (_e, win) => { try { state.wrapWindow?.(win); if (state.windowMaterial) Object.getPrototypeOf(win).setVibrancy.call(win, state.windowMaterial); } catch {} });
  }
  state.wrapWindow = wrapWindow;

  // a frame-clearing rule inserted by hand before this was built in
  if (state.frameKey) { for (const f of frames()) await f.removeInsertedCSS(state.frameKey).catch(() => {}); state.frameKey = null; }

  stopMains();
  loadTheme();
  loadExtensions();
  startMains();
  state.windowMaterial = state.windowMaterial ?? null;
  await applyWindowMaterial();

  // Watch the theme and extension folders and config.json; changes apply live.
  for (const w of state.watchers || []) { try { w.close(); } catch {} }
  clearTimeout(state.reloadDebounce);
  state.watchers = [];
  for (const d of [userThemesDir, extRoots.user]) { try { fs.mkdirSync(d, { recursive: true }); } catch {} }
  const changed = () => {
    clearTimeout(state.reloadDebounce);
    state.reloadDebounce = setTimeout(() => { try { state.lastFingerprint = fingerprint(); } catch {} Promise.resolve(state.reloadAll?.()).catch((e) => log(e)); }, 250);
  };
  const watch = (dir, opts, only) => {
    try {
      const w = fs.watch(dir, opts, (_ev, name) => { if (!only || name === only) changed(); });
      w.on('error', () => {});
      state.watchers.push(w);
    } catch {}
  };
  for (const d of themeDirs) watch(d, {});
  for (const d of [extRoots.bundled, extRoots.user]) watch(d, { recursive: true });
  try { fs.mkdirSync(path.dirname(configPath), { recursive: true }); } catch {}
  watch(path.dirname(configPath), {}, path.basename(configPath));

  // Safety net: file-change events can be dropped (macOS especially), so every few seconds compare a cheap
  // fingerprint (names, sizes, times) of config.json, the theme files and the extension files.
  const fingerprint = () => {
    const parts = [];
    const stat = (f) => { try { const st = fs.statSync(f); parts.push(`${f}:${st.size}:${st.mtimeMs}`); } catch { parts.push(`${f}:-`); } };
    const list = (d) => { try { return fs.readdirSync(d); } catch { return []; } };
    stat(configPath);
    for (const d of themeDirs) for (const f of list(d)) stat(path.join(d, f));
    for (const root of [extRoots.bundled, extRoots.user]) for (const e of list(root)) for (const f of list(path.join(root, e))) stat(path.join(root, e, f));
    return parts.join('|');
  };
  clearInterval(state.pollTimer);
  state.lastFingerprint = fingerprint();
  state.pollTimer = setInterval(() => {
    const now = fingerprint();
    if (now !== state.lastFingerprint) { state.lastFingerprint = now; changed(); }
  }, 4000);

  // Fresh apply: everything is re-run in each open view.
  const applied = [];
  await serial(async () => {
    for (const wc of webContents.getAllWebContents()) {
      hook(wc);
      if (!isTarget(wc)) continue;
      state.ran.delete(wc.id);
      state.themeApplied.delete(wc.id);
      await applyTo(wc);
      applied.push(wc.id);
    }
  });
  return { applied, theme: state.theme.current, themeErrors: state.theme.errors, extensions: [...state.extLoaded.keys()], mains: [...state.mains.keys()] };
})()
