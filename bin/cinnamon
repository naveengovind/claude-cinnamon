#!/bin/sh
# cinnamon — Cinnamon's command. Finds its install (also through links) and runs core/cli/main.ts with Bun.
src=$0
while [ -L "$src" ]; do
  t=$(readlink "$src")
  case "$t" in /*) src=$t ;; *) src=$(dirname "$src")/$t ;; esac
done
root=${CINNAMON_ROOT:-$(cd "$(dirname "$src")/.." && pwd)}
. "$root/core/runtime.sh"
js=$(cinnamon_bun)
if [ -z "$js" ]; then
  echo "cinnamon needs Bun (brew install oven-sh/bun/bun)" >&2
  exit 1
fi
CINNAMON_ROOT=$root exec "$js" "$root/core/cli/main.ts" "$@"
