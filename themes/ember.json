{
  "name": "Ember",
  "description": "Hot orange haze: a slow-drifting sun and twinkling stars glowing behind see-through panels (also in the Code tab and the Claude mobile app)",
  "overrideColorScheme": "dark",
  "backdrop": {
    "svg": "ember.svg",
    "glass": {
      "blur": 16,
      "tint": "#1a0902",
      "opacity": 0.5
    },
    "alt": "A slow-drifting orange sun and twinkling stars"
  },
  "codeTab": {
    "roles": {
      "accent": "#ff7a1a",
      "danger": "#ff5a4a",
      "success": "#7fd18b"
    },
    "dark": {
      "gray": {
        "anchors": {
          "surface-0": "#170700",
          "surface-1": "#1a0902",
          "surface-2": "#2a1004",
          "surface-3": "#2c1104",
          "text-primary": "#fff2e6",
          "text-secondary": "#ffcfa6",
          "text-muted": "#f2c29c"
        }
      }
    }
  },
  "dark": {
    "background": "transparent",
    "background-deep": "#12060080",
    "frame": "transparent",
    "panel": "#1d0a028c",
    "sidebar": "#140600b3",
    "text-sidebar": "#ffd9b8",
    "raised": "#2a1004e6",
    "popover": "#2c1104eb",
    "code-background": "#0f0400cc",
    "text": "#fff2e6",
    "text-secondary": "#ffcfa6",
    "text-muted": "#f2c29c",
    "placeholder": "#c98e63",
    "border": "#ff8a3d33",
    "border-faint": "#ff8a3d1f",
    "hover": "#ff7a1a1f",
    "selected": "#ff7a1a33",
    "selected-hover": "#ff7a1a40",
    "accent": "#ff7a1a",
    "accent-hover": "#ff9440",
    "button": "#ff7a1a",
    "button-hover": "#ff9440",
    "button-text": "#1a0700",
    "vars": {
      "--cds-bg-user-message": "#ff7a1a26"
    }
  },
  "css": "body { background: #170700 !important; }\n.epitaxy-prompt .bg-surface-3, .bg-surface-3.rounded-composer { box-shadow: inset 0 0 0 1px #ff8a3d33, 0 8px 30px #00000040 !important; }"
}
